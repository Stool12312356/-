.env
.env.*
!.env.example
*.pem
*.key

# Исходные (несжатые) модели — только локально, 386 МБ, см. tools/download-assets.sh
assets/models/
assets/_split/

# Облегчённые текстуры для слабых ПК — собираются из models, не нужны в git
public/assets/game-low/
google_drive/

# облегчённые версии моделей (без лишних деталей) — генерируются из assets/models
assets/_vm/*
