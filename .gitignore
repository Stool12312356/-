# Зависимости и сборка (не попадают в снапшот)
node_modules/
dist/
build/
out/
target/
.next/
.nuxt/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
